# AIDE 智能助手 - 默认配置
# 开发者维护此文件，随升级包更新
# 用户自定义配置请写到 user/user.env（优先级更高，升级不覆盖）

# ===== 应用 =====
APP_NAME=AI Assistant
APP_VERSION=0.3.0
DEBUG=false
HOST=0.0.0.0
PORT=8900

# ===== LLM配置 =====
# 当前provider: vllm / tencent / openai / custom
LLM_PROVIDER=vllm

# vLLM (本地部署)
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=not-needed
LLM_MODEL=qwen3.6-27B

# 腾讯TokenHub
LLM_TENCENT_BASE_URL=https://api.lkeap.cloud.tencent.com/plan/v3
LLM_TENCENT_API_KEY=
LLM_TENCENT_MODEL=glm-5.1

# DeepSeek / 通义千问 / Moonshot 等 (OpenAI兼容)
LLM_OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_OPENAI_API_KEY=
LLM_OPENAI_MODEL=deepseek-chat

# 自定义端点
LLM_CUSTOM_BASE_URL=
LLM_CUSTOM_API_KEY=
LLM_CUSTOM_MODEL=

# 通用参数
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7
# 模型上下文窗口大小（token数）：Qwen3.6-27B=32768, Qwen2.5-72B=131072, DeepSeek-V3=65536
# 超过此限制会自动截断早期对话，防止400错误
LLM_CONTEXT_WINDOW=32768
# 上下文最大消息条数（兜底限制，按条数截断）
LLM_MAX_CONTEXT_MESSAGES=20
# 是否启用思考模式（Qwen3等带<与>think>标签的模型设为true，普通模型设为false）
# 思考模式下思考过程会单独展示，回答内容不含思考标签
LLM_THINKING_MODEL=true

# ===== 达梦数据库 =====
DM_HOST=192.168.1.XX
DM_STANDBY_HOST=192.168.1.XX
DM_PORT=5236
DM_USERNAME=dmdb
DM_PASSWORD=
DM_DATABASE=lczx

# ====OA =====
SEELYON_BASE_URL=
SEELYON_USERNAME=
SEELYON_PASSWORD=

# ===== 邮件通知 =====
EMAIL_SMTP=smtp.qq.com
EMAIL_SMTP_PORT=465
EMAIL_SENDER=your-email@example.com
EMAIL_PASSWORD=
